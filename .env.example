# ==============================================================================
# Listening Index — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NOTE: No local PostgreSQL installation or Docker container is needed!
# You can paste your existing Neon connection URL directly into DATABASE_URL.
# ==============================================================================

# Database Connection (Neon Serverless Postgres)
# Copy from Vercel Project -> Storage -> Neon Postgres, or console.neon.tech
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"
# POSTGRES_URL is also accepted if configured by Vercel Postgres integration:
# POSTGRES_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Administrator Password
# Used to authenticate admin operations: saving global customization to Neon DB,
# uploading extended listening history files, and UI-triggered manual syncs.
ADMIN_PASSWORD="change_this_to_a_secure_admin_password"

# Spotify Web API Credentials
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Spotify OAuth Refresh Token
# Generate using `npm run auth:spotify` or the manual OAuth curl flow in README
SPOTIFY_REFRESH_TOKEN="your_spotify_refresh_token"

# Sync Endpoint Secret Token
# Protects /api/sync endpoint from unauthorized execution.
# Generate using `npm run generate:cron` or via https://generate-secret.vercel.app/32
CRON_SECRET="your_secure_cron_secret"
